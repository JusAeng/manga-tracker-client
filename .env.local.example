NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_LIFF_ID=2002829031-VRBZNkb5

# Optional, dev only: set this to skip the real LIFF/LINE login entirely.
# Mint one with `make devtoken` (or `make devtoken ARGS="-user-id <uuid>"`
# to see real profile data) in manga-tracker-api-go. Leave unset to test
# the real LIFF flow, and never set this in a deployed build.
NEXT_PUBLIC_DEV_TOKEN=

# Optional, dev only: "true" runs the whole app off app/mock/manga.ts —
# no backend, no devtoken, no Supabase needed at all. Takes priority over
# NEXT_PUBLIC_DEV_TOKEN when both are set. Never set this in a deployed
# build (it would show made-up data to real users).
NEXT_PUBLIC_USE_MOCK_DATA=
